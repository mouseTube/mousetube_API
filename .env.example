# Copy to .env and fill in. See the table in README.md.
DEBUG=true
# Required when DEBUG=false:
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONT_DOMAIN=localhost:3000

DB_ENGINE=django.db.backends.mysql
DB_ROOT_PASS=
DB_NAME=mousetube
DB_USER=mousetube
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=False

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Number of reverse proxies in front of Django (HAProxy + nginx = 2). 0 = none.
DRF_NUM_PROXIES=0

# Publication to Zenodo (sandbox by default) and ORCID login
ZENODO_API=https://sandbox.zenodo.org/api/
ZENODO_TOKEN=
CLIENT_ID=
CLIENT_SECRET=
